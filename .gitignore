# Rust build artifacts.
/target/
# The tools/ programs are their own workspaces: built against a copy of the
# root lockfile, ideally into the root target/ (see their READMEs).
/tools/*/target/
/tools/*/Cargo.lock
**/*.rs.bk

# Editor / IDE scratch files.
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# macOS / Windows / Linux desktop clutter.
.DS_Store
Thumbs.db

# Local CI (act) cache.
.act/

# Local agent/tooling scratch (review diffs).
.superpowers/

# Harness-managed git worktrees.
/.claude/worktrees/
