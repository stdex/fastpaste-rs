// Options Dialog: FSidebar navigation + form pages, built on the compact
// in-house widget set (widgets.slint). The old version used std-widgets'
// vertical TabWidget + fluent widgets, which meant ~48px tab rows, tall
// controls, and inactive-tab text tuned for a dark sidebar (white-on-
// white on our light window).
//
// Four pages map to the `Settings` sub-structs:
//
//   General            → GeneralSettings.language (ComboBox)
//   Hot Keys           → HotkeySettings.open_dialog / .open_main_window
//   Clipboard History  → ClipboardHistorySettings.enabled / .max_items / .position
//   Paste Options      → PasteSettings.delay_ms / .restore_clipboard
//
// Buttons: OK / Cancel / Apply. They fire the matching callback; the
// controller (main.rs) reads the in-out properties and either persists
// (OK, Apply) or drops the changes (Cancel). OK also hides the window
// after the controller commits.
//
// Page state lives in the root's in-out properties (not in page-local
// elements), so the `if active-page == N` blocks can be torn down and
// recreated without losing typed-but-uncommitted values.

import { FSidebar, FButton, FLineEdit, FComboBox, FCheckBox, FSpinBox, Theme }
from "widgets.slint";
import { Translations } from "translations.slint";

export struct LanguageOption {
    code: string,   // e.g. "system", "en", "ru"
    label: string,  // e.g. "System default", "English"
}

// A form label.
//
// Pages lay out with `GridLayout`, so the label column sizes itself to
// the longest label on that page and every control shares one left edge.
// The previous `width: 150px` gutter was not a grid at all: it clipped
// the Russian and German labels mid-word, and rows whose control was a
// checkbox skipped the gutter entirely, so nothing lined up.
component FLabel inherits Text {
    vertical-alignment: center;
    horizontal-alignment: left;
    font-size: Theme.font-size;
    color: Theme.text;
    // Labels are the one thing allowed to set the column width.
    horizontal-stretch: 0;
}

// Muted explanatory line under a group of fields.
component FHint inherits Text {
    wrap: word-wrap;
    font-size: Theme.font-size-s;
    color: Theme.text-muted;
    horizontal-stretch: 1;
}

// Page heading. The sidebar already names the section, but without a
// heading the form starts flush against the top edge with no anchor.
component FPageTitle inherits Text {
    font-size: Theme.font-size-title;
    font-weight: 600;
    color: Theme.text;
    vertical-stretch: 0;
}

export component OptionsDialog inherits Window {
    title: "fastpaste — " + Translations.options-title;
    // Sized for the widest shipped locale: a 200px sidebar, the longest
    // Russian label, and a 240px field all have to fit on one row
    // without the field running off the edge.
    preferred-width: 700px;
    preferred-height: 460px;
    min-width: 640px;
    min-height: 380px;
    background: Theme.window-bg;

    // Accepted numeric ranges, pushed from Rust so `MAX_ITEMS_RANGE` /
    // `DELAY_MS_RANGE` in `fastpaste-app` are the single authority.
    // Hardcoding them here meant a legal config value (say max_items =
    // 200) displayed fine but was squashed to the widget's own cap the
    // moment the user touched the control, and then persisted.
    in property <int> history-max-items-min: 1;
    in property <int> history-max-items-max: 500;
    in property <int> paste-delay-min: 0;
    in property <int> paste-delay-max: 5000;

    // Validation feedback. Non-empty text raises the status line in the
    // button bar. Without it a rejected hotkey produced nothing but a log
    // line the user never sees and a field that snapped back, which reads
    // as "the button did nothing".
    in-out property <string> status-message: "";

    // -- General -------------------------------------------------------------
    // `languages` carries the (code,label) pairs; `language-labels` is the
    // ComboBox's display model. `language-index` is the selected row.
    // The controller seeds all three at show time from `Settings.general.language`.
    in-out property <[LanguageOption]> languages;
    in-out property <[string]> language-labels;
    in-out property <int> language-index: 0;

    // -- Hot Keys --------------------------------------------------------------
    in-out property <string> hotkey-open-dialog: "Ctrl+U";
    in-out property <string> hotkey-open-main-window: "Ctrl+Shift+U";

    // -- Clipboard History -------------------------------------------------
    in-out property <bool> history-enabled: true;
    in-out property <int> history-max-items: 10;
    // 0 = "Top", 1 = "Bottom".
    in-out property <int> history-position-index: 1;

    // -- Paste Options --------------------------------------------------------
    in-out property <int> paste-delay-ms: 70;
    in-out property <bool> paste-restore-clipboard: true;

    // -- Navigation -----------------------------------------------------------
    in-out property <int> active-page: 0;

    // -- Buttons -----------------------------------------------------------
    callback ok-clicked();
    callback cancel-clicked();
    callback apply-clicked();

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-clicked();
                return accept;
            }
            if (event.text == Key.Return) {
                root.ok-clicked();
                return accept;
            }
            reject
        }

    VerticalLayout {
        // Top: sidebar (left) + form page (right).
        HorizontalLayout {
            FSidebar {
                items: [
                    Translations.options-general,
                    Translations.options-hotkeys,
                    Translations.options-clipboard-history,
                    Translations.options-paste,
                ];
                current-index <=> root.active-page;
            }

            // Hairline between sidebar and form. `horizontal-stretch: 0`
            // is load-bearing: a bare Rectangle stretches by default, and
            // this 1px rule rendered as a ~15px grey column.
            Rectangle {
                width: 1px;
                horizontal-stretch: 0;
                background: Theme.border;
            }

            Rectangle {
                background: Theme.surface;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.padding-l;
                    spacing: Theme.spacing;
                    // Rows sit at the top of the page and keep their own
                    // height; without this the layout spreads them down
                    // the full height of the dialog.
                    alignment: start;

                    // -- General (page 0) --
                    if root.active-page == 0: VerticalLayout {
                        spacing: Theme.spacing;
                        alignment: start;

                        FPageTitle { text: Translations.options-general; }

                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.row-spacing;

                            Row {
                                FLabel { text: Translations.options-language-label; }
                                FComboBox {
                                    model: root.language-labels;
                                    current-index <=> root.language-index;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: ""; }
                                FHint { colspan: 2; text: Translations.options-language-hint; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    // -- Hot Keys (page 1) --
                    if root.active-page == 1: VerticalLayout {
                        spacing: Theme.spacing;
                        alignment: start;

                        FPageTitle { text: Translations.options-hotkeys; }

                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.row-spacing;

                            Row {
                                FLabel { text: Translations.options-open-dialog-label; }
                                FLineEdit { text <=> root.hotkey-open-dialog; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: Translations.options-open-main-window-label; }
                                FLineEdit { text <=> root.hotkey-open-main-window; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: ""; }
                                FHint { colspan: 2; text: Translations.options-hotkeys-hint; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    // -- Clipboard History (page 2) --
                    if root.active-page == 2: VerticalLayout {
                        spacing: Theme.spacing;
                        alignment: start;

                        FPageTitle { text: Translations.options-clipboard-history; }

                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.row-spacing;

                            // The checkbox sits in the CONTROL column, not
                            // flush left, so every interactive element on
                            // the page shares one left edge.
                            Row {
                                FLabel { text: ""; }
                                FCheckBox {
                                    colspan: 2;
                                    text: Translations.options-capture-history;
                                    checked <=> root.history-enabled;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: Translations.options-max-items-label; }
                                // A GridLayout stretches its cell to the
                                // column, ignoring the child's own
                                // max-width, so the narrow spin box would
                                // be blown up to the width of the widest
                                // control in the column. `alignment:
                                // start` hands it its natural size.
                                HorizontalLayout {
                                    alignment: start;
                                    FSpinBox {
                                        minimum: root.history-max-items-min;
                                        maximum: root.history-max-items-max;
                                        value <=> root.history-max-items;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: Translations.options-folder-position-label; }
                                FComboBox {
                                    model: [
                                        Translations.options-position-top,
                                        Translations.options-position-bottom,
                                    ];
                                    current-index <=> root.history-position-index;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    // -- Paste Options (page 3) --
                    if root.active-page == 3: VerticalLayout {
                        spacing: Theme.spacing;
                        alignment: start;

                        FPageTitle { text: Translations.options-paste; }

                        GridLayout {
                            spacing-horizontal: Theme.spacing;
                            spacing-vertical: Theme.row-spacing;

                            Row {
                                FLabel { text: Translations.options-paste-delay-label; }
                                HorizontalLayout {
                                    alignment: start;
                                    FSpinBox {
                                        minimum: root.paste-delay-min;
                                        maximum: root.paste-delay-max;
                                        value <=> root.paste-delay-ms;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Row {
                                FLabel { text: ""; }
                                FCheckBox {
                                    colspan: 2;
                                    text: Translations.options-restore-clipboard;
                                    checked <=> root.paste-restore-clipboard;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }

        // Hairline above the button bar. Same stretch caveat as the
        // vertical rule above.
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }

        // ---- Bottom button bar ----
        Rectangle {
            background: Theme.window-bg;
            vertical-stretch: 0;
            height: Theme.control-height + 2 * Theme.padding;

            HorizontalLayout {
                padding-left: Theme.padding-l;
                padding-right: Theme.padding-l;
                // Vertical padding is what actually sizes the buttons.
                // A layout stretches its children on the CROSS axis and
                // a child's `max-height` does not stop it, so the only
                // reliable way to get a `control-height` button is to
                // make the content box exactly that tall. Without these
                // two lines the buttons filled the whole 54px bar.
                padding-top: Theme.padding;
                padding-bottom: Theme.padding;
                spacing: Theme.spacing;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: root.status-message;
                    font-size: Theme.font-size-s;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                // A shared minimum keeps the three buttons the same
                // width regardless of caption length, which is what
                // makes a button row read as a row.
                FButton {
                    min-width: 92px;
                    text: Translations.options-cancel;
                    clicked => { root.cancel-clicked(); }
                }
                FButton {
                    min-width: 92px;
                    text: Translations.options-apply;
                    clicked => { root.apply-clicked(); }
                }
                FButton {
                    min-width: 92px;
                    text: Translations.options-ok;
                    primary: true;
                    clicked => { root.ok-clicked(); }
                }
            }
        }
    }

    }
}
