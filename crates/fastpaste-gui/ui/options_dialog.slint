// Options Dialog: FSidebar navigation + form pages, built on the compact
// in-house widget set (widgets.slint). The old version used std-widgets'
// vertical TabWidget + fluent widgets, which meant ~48px tab rows, tall
// controls, and inactive-tab text tuned for a dark sidebar (white-on-
// white on our light window).
//
// Four pages map to the `Settings` sub-structs:
//
//   General            → GeneralSettings.language (ComboBox)
//   Hot Keys           → HotkeySettings.open_dialog / .open_main_window
//   Clipboard History  → ClipboardHistorySettings.enabled / .max_items / .position
//   Paste Options      → PasteSettings.delay_ms / .restore_clipboard
//
// Buttons: OK / Cancel / Apply. They fire the matching callback; the
// controller (main.rs) reads the in-out properties and either persists
// (OK, Apply) or drops the changes (Cancel). OK also hides the window
// after the controller commits.
//
// Page state lives in the root's in-out properties (not in page-local
// elements), so the `if active-page == N` blocks can be torn down and
// recreated without losing typed-but-uncommitted values.

import { FSidebar, FButton, FLineEdit, FComboBox, FCheckBox, FSpinBox, Theme }
from "widgets.slint";
import { Translations } from "translations.slint";

export struct LanguageOption {
    code: string,   // e.g. "system", "en", "ru"
    label: string,  // e.g. "System default", "English"
}

// One form row: fixed-width label column + a stretching control. Shared
// by every page so the label gutters line up across the dialog (the old
// stacked VerticalLayout produced ragged, misaligned rows).
component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: Theme.spacing;

    Text {
        width: 150px;
        text: root.label;
        vertical-alignment: center;
        font-size: Theme.font-size;
        color: Theme.text;
    }

    @children
}

export component OptionsDialog inherits Window {
    title: "fastpaste — " + Translations.options-title;
    preferred-width: 560px;
    preferred-height: 400px;
    background: Theme.window-bg;

    // Accepted numeric ranges, pushed from Rust so `MAX_ITEMS_RANGE` /
    // `DELAY_MS_RANGE` in `fastpaste-app` are the single authority.
    // Hardcoding them here meant a legal config value (say max_items =
    // 200) displayed fine but was squashed to the widget's own cap the
    // moment the user touched the control, and then persisted.
    in property <int> history-max-items-min: 1;
    in property <int> history-max-items-max: 500;
    in property <int> paste-delay-min: 0;
    in property <int> paste-delay-max: 5000;

    // Validation feedback. Non-empty text raises the status line in the
    // button bar. Without it a rejected hotkey produced nothing but a log
    // line the user never sees and a field that snapped back, which reads
    // as "the button did nothing".
    in-out property <string> status-message: "";

    // -- General -------------------------------------------------------------
    // `languages` carries the (code,label) pairs; `language-labels` is the
    // ComboBox's display model. `language-index` is the selected row.
    // The controller seeds all three at show time from `Settings.general.language`.
    in-out property <[LanguageOption]> languages;
    in-out property <[string]> language-labels;
    in-out property <int> language-index: 0;

    // -- Hot Keys --------------------------------------------------------------
    in-out property <string> hotkey-open-dialog: "Ctrl+U";
    in-out property <string> hotkey-open-main-window: "Ctrl+Shift+U";

    // -- Clipboard History -------------------------------------------------
    in-out property <bool> history-enabled: true;
    in-out property <int> history-max-items: 10;
    // 0 = "Top", 1 = "Bottom".
    in-out property <int> history-position-index: 1;

    // -- Paste Options --------------------------------------------------------
    in-out property <int> paste-delay-ms: 70;
    in-out property <bool> paste-restore-clipboard: true;

    // -- Navigation -----------------------------------------------------------
    in-out property <int> active-page: 0;

    // -- Buttons -----------------------------------------------------------
    callback ok-clicked();
    callback cancel-clicked();
    callback apply-clicked();

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-clicked();
                return accept;
            }
            if (event.text == Key.Return) {
                root.ok-clicked();
                return accept;
            }
            reject
        }

    VerticalLayout {
        // Top: sidebar (left) + form page (right).
        HorizontalLayout {
            FSidebar {
                items: [
                    Translations.options-general,
                    Translations.options-hotkeys,
                    Translations.options-clipboard-history,
                    Translations.options-paste,
                ];
                current-index <=> root.active-page;
            }

            // Vertical separator between sidebar and form.
            Rectangle {
                preferred-width: 1px;
                background: Theme.border;
            }

            Rectangle {
                background: Theme.surface;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.padding + Theme.spacing-s;
                    spacing: Theme.spacing;

                    // -- General (page 0) --
                    if root.active-page == 0: VerticalLayout {
                        spacing: Theme.spacing;

                        FormRow {
                            label: Translations.options-language-label;
                            FComboBox {
                                model: root.language-labels;
                                current-index <=> root.language-index;
                            }
                        }
                        Text {
                            text: Translations.options-language-hint;
                            wrap: word-wrap;
                            font-size: Theme.font-size-s;
                            color: Theme.text-muted;
                        }
                    }

                    // -- Hot Keys (page 1) --
                    if root.active-page == 1: VerticalLayout {
                        spacing: Theme.spacing;

                        FormRow {
                            label: Translations.options-open-dialog-label;
                            FLineEdit {
                                text <=> root.hotkey-open-dialog;
                            }
                        }
                        FormRow {
                            label: Translations.options-open-main-window-label;
                            FLineEdit {
                                text <=> root.hotkey-open-main-window;
                            }
                        }
                        Text {
                            text: Translations.options-hotkeys-hint;
                            wrap: word-wrap;
                            font-size: Theme.font-size-s;
                            color: Theme.text-muted;
                        }
                    }

                    // -- Clipboard History (page 2) --
                    if root.active-page == 2: VerticalLayout {
                        spacing: Theme.spacing;

                        FCheckBox {
                            text: Translations.options-capture-history;
                            checked <=> root.history-enabled;
                        }
                        FormRow {
                            label: Translations.options-max-items-label;
                            FSpinBox {
                                minimum: root.history-max-items-min;
                                maximum: root.history-max-items-max;
                                value <=> root.history-max-items;
                            }
                        }
                        FormRow {
                            label: Translations.options-folder-position-label;
                            FComboBox {
                                model: [
                                    Translations.options-position-top,
                                    Translations.options-position-bottom,
                                ];
                                current-index <=> root.history-position-index;
                            }
                        }
                    }

                    // -- Paste Options (page 3) --
                    if root.active-page == 3: VerticalLayout {
                        spacing: Theme.spacing;

                        FormRow {
                            label: Translations.options-paste-delay-label;
                            FSpinBox {
                                minimum: root.paste-delay-min;
                                maximum: root.paste-delay-max;
                                value <=> root.paste-delay-ms;
                            }
                        }
                        FCheckBox {
                            text: Translations.options-restore-clipboard;
                            checked <=> root.paste-restore-clipboard;
                        }
                    }
                }
            }
        }

        // Vertical separator between body and button bar.
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // ---- Bottom button bar ----
        HorizontalLayout {
            padding: Theme.spacing;
            spacing: Theme.spacing;

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.status-message;
                font-size: Theme.font-size-s;
                color: Theme.danger;
                wrap: word-wrap;
            }

            FButton {
                text: Translations.options-cancel;
                clicked => { root.cancel-clicked(); }
            }
            FButton {
                text: Translations.options-apply;
                clicked => { root.apply-clicked(); }
            }
            FButton {
                text: Translations.options-ok;
                primary: true;
                clicked => { root.ok-clicked(); }
            }
        }
    }

    }
}
