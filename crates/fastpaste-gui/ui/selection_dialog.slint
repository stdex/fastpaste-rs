// Selection dialog: the hotkey popup listing snippets with keyboard
// navigation. The Rust side sets the `snippets` model and wires
// `paste-selected` / `closed` / `filter-changed` callbacks.
//
// Notes on keyboard handling: in Slint, only `FocusScope` (and
// `TextInput`) declare the `key-pressed` callback. The filter field is a
// `TextInput`, so it takes focus and forwards the navigation keys it does
// not consume itself; that way typing filters and the arrows still move
// the selection, without the user having to think about focus at all.
//
// Rows are two-line (title + first line of the body) so the user can tell
// snippets apart without opening them.

import { ListView } from "std-widgets.slint";
import { Translations } from "translations.slint";
import { Theme } from "widgets.slint";

// One row in the dialog's list. Slint generates a Rust struct with matching
// fields, accessible from Rust as `SnippetRow` after `slint::include_modules!()`.
// Marked `export` so the root file (ui/main.slint) can re-export it alongside
// the SelectionDialog component.
export struct SnippetRow {
    title: string,
    body: string,
    /// Short type marker shown right-aligned on the title line, e.g.
    /// "История". Empty for saved snippets.
    ///
    /// This replaces the folder name that used to be pasted onto the
    /// front of every history row's title ("История буфера обмена: git
    /// status"): 23 characters of identical prefix on every row, pushing
    /// the part the user is actually reading off the right edge.
    tag: string,
    /// A non-selectable group heading rather than a pasteable row.
    ///
    /// Rust emits one before each group when more than one group is on
    /// screen, so a lone group never carries a pointless heading.
    is-header: bool,
}

export component SelectionDialog inherits Window {
    title: "fastpaste — " + Translations.selection-dialog-title;
    preferred-width: 400px;
    preferred-height: 340px;
    background: Theme.surface;

    // List of snippets, set from Rust (already filtered).
    in-out property <[SnippetRow]> snippets;

    // Currently-selected index (clamped to 0 from Rust at show time).
    in-out property <int> selected-index: 0;

    // The live filter text. Rust owns the filtering so the index the
    // paste callback receives always refers to the list on screen.
    in-out property <string> filter-text: "";

    // Emitted when the user picks a snippet (Enter or double-click).
    callback paste-selected(int /* index */);
    // Emitted when the user closes the dialog (Esc).
    callback closed();
    // Emitted on every filter keystroke; Rust re-populates `snippets`.
    callback filter-changed(string);

    // Height of one row, used to scroll the selection into view.
    property <length> row-height: 42px;
    // Group headings are shorter than rows.
    property <length> header-height: 26px;

    // Rows per PageUp/PageDown — a screenful, so it still matches after
    // the window is resized.
    property <int> page-rows: Math.max(1, Math.floor(list.visible-height / root.row-height));

    forward-focus: filter;

    // Move the selection by `delta`, wrapping at both ends, and keep it
    // on screen. Wrapping matters for a short keyboard-driven list: with
    // 3 snippets, Up from the first should reach the last rather than do
    // nothing.
    // Wrapping index arithmetic, factored out so the header-skipping
    // below can apply it twice.
    pure function wrapped(i: int, delta: int) -> int {
        Math.mod(i + delta + root.snippets.length, root.snippets.length)
    }

    function move-selection(delta: int) {
        if (root.snippets.length == 0) {
            return;
        }
        let target = root.wrapped(root.selected-index, delta);
        // Step over a group heading. One extra step is always enough:
        // a heading is only emitted for a non-empty group, so two
        // headings can never be adjacent. (Slint has no `while`, which
        // is also why the TreeView component delegates this to its host
        // — the same limitation, solved here by bounding the problem.)
        root.selected-index = root.snippets[target].is-header
            ? root.wrapped(target, delta)
            : target;
        root.scroll-into-view();
    }

    // Called from Rust after the model is repopulated (a filter
    // keystroke, or reopening the dialog). Setting `selected-index` from
    // Rust does not run `set-selection`, so without this the selection
    // snapped to the top while the viewport stayed scrolled where it was
    // — the highlighted row off-screen, which is the symptom the
    // scroll-into-view work existed to remove.
    public function reset-view() {
        // Land on the first pasteable row: with both groups on screen
        // index 0 is a group heading.
        root.selected-index =
            root.snippets.length > 0 && root.snippets[0].is-header ? 1 : 0;
        list.viewport-y = 0;
    }

    // Home/End. `delta` says which way to step off a heading: forward
    // for Home (the first row may be one), backward for End (the last
    // row never is, since a heading always precedes its group).
    function set-selection(i: int, delta: int) {
        if (root.snippets.length == 0) {
            return;
        }
        let target = Math.max(0, Math.min(root.snippets.length - 1, i));
        root.selected-index = root.snippets[target].is-header
            ? root.wrapped(target, delta)
            : target;
        root.scroll-into-view();
    }

    // Keep the selected row inside the viewport. `ListView` does not
    // follow a manually-tracked index, so without this the selection
    // walked straight off the bottom of the window and the user was
    // navigating blind past ~7 rows.
    function scroll-into-view() {
        if (root.selected-index * root.row-height < -list.viewport-y) {
            list.viewport-y = -root.selected-index * root.row-height;
        } else if ((root.selected-index + 1) * root.row-height
                   > -list.viewport-y + list.visible-height) {
            list.viewport-y =
                list.visible-height - (root.selected-index + 1) * root.row-height;
        }
    }

    VerticalLayout {
        // ── Filter ───────────────────────────────────────────────────
        Rectangle {
            height: Theme.control-height + 12px;
            vertical-stretch: 0;
            background: Theme.surface;

            Rectangle {
                x: 8px;
                y: 6px;
                width: parent.width - 16px;
                height: Theme.control-height;
                background: Theme.surface;
                border-color: filter.has-focus ? Theme.accent : Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;

                // Same inset as the TextInput below, or the placeholder
                // and the caret sit a couple of pixels apart.
                if root.filter-text == "": Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 100%;
                    vertical-alignment: center;
                    text: Translations.selection-filter-placeholder;
                    font-size: Theme.font-size;
                    color: Theme.text-muted;
                    overflow: elide;
                }

                filter := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 100%;
                    vertical-alignment: center;
                    font-size: Theme.font-size;
                    color: Theme.text;
                    single-line: true;
                    text <=> root.filter-text;

                    edited => {
                        root.filter-changed(self.text);
                    }
                    // Navigation keys are forwarded rather than consumed,
                    // so the user never has to leave the filter field.
                    key-pressed(event) => {
                        if (event.text == Key.UpArrow) {
                            root.move-selection(-1);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.move-selection(1);
                            return accept;
                        }
                        if (event.text == Key.PageUp) {
                            root.move-selection(-root.page-rows);
                            return accept;
                        }
                        if (event.text == Key.PageDown) {
                            root.move-selection(root.page-rows);
                            return accept;
                        }
                        if (event.text == Key.Home && self.text == "") {
                            root.set-selection(0, 1);
                            return accept;
                        }
                        if (event.text == Key.End && self.text == "") {
                            root.set-selection(root.snippets.length - 1, -1);
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            if (root.snippets.length > 0
                                && root.snippets[root.selected-index].is-header == false) {
                                root.paste-selected(root.selected-index);
                            }
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.closed();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }

        // ── List (with the empty state layered over it) ──────────────
        // The ListView is unconditional: `scroll-into-view` above refers
        // to it by id, and an element declared inside an `if` is not in
        // scope there.
        Rectangle {
            vertical-stretch: 1;

            if root.snippets.length == 0: Text {
                width: 100%;
                height: 100%;
                text: Translations.selection-empty;
                font-size: Theme.font-size;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            list := ListView {
                width: 100%;
                height: 100%;

                for snippet[i] in root.snippets: Rectangle {
                    height: snippet.is-header ? root.header-height : root.row-height;
                    background: snippet.is-header
                        ? transparent
                        : (i == root.selected-index
                            ? Theme.selection-bg
                            : touch.has-hover ? Theme.hover-bg : transparent);

                    // ---- Group heading -----------------------------
                    if snippet.is-header: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: Theme.spacing-s;

                        Text {
                            text: snippet.title;
                            vertical-alignment: bottom;
                            font-size: Theme.font-size-s;
                            font-weight: 600;
                            color: Theme.text-muted;
                            horizontal-stretch: 0;
                        }
                        // Rule filling the rest of the line, so a
                        // heading reads as a divider rather than as
                        // another row of the list.
                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                y: parent.height / 2;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                    }

                    // Accent bar on the selected row, matching the
                    // options sidebar. A fill alone is easy to lose track
                    // of while arrowing quickly through a long list.
                    if snippet.is-header == false: Rectangle {
                        x: 0;
                        y: 6px;
                        width: 3px;
                        height: parent.height - 12px;
                        border-radius: 2px;
                        background: i == root.selected-index
                            ? Theme.accent : transparent;
                    }

                    if snippet.is-header == false: VerticalLayout {
                        padding: Theme.spacing-s;
                        padding-left: 12px;
                        padding-right: 10px;
                        // Centred, not top-aligned: a clipboard-history
                        // row has no second line (its title already IS
                        // the text), and top-aligning left it floating
                        // above an empty half-row.
                        alignment: center;

                        HorizontalLayout {
                            spacing: Theme.spacing-s;

                            Text {
                                text: snippet.title;
                                font-size: Theme.font-size;
                                font-weight: i == root.selected-index ? 600 : 400;
                                color: i == root.selected-index
                                    ? Theme.selection-fg : Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            // Type marker, right-aligned so it never
                            // competes with the text for the left edge.
                            if snippet.tag != "": Text {
                                text: snippet.tag;
                                font-size: Theme.font-size-s;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                        }
                        if snippet.body != "": Text {
                            text: snippet.body;
                            font-size: Theme.font-size-s;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                    }

                    // Headings are not click targets.
                    touch := TouchArea {
                        enabled: snippet.is-header == false;
                        clicked => {
                            root.selected-index = i;
                        }
                        double-clicked => {
                            root.paste-selected(i);
                        }
                    }
                }
            }
        }

        // ── Keyboard hints ───────────────────────────────────────────
        // The whole point of this dialog is that it is driven from the
        // keyboard, and nothing on screen said so.
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }
        Rectangle {
            height: 26px;
            vertical-stretch: 0;
            background: Theme.window-bg;

            Text {
                x: 12px;
                width: parent.width - 24px;
                height: 100%;
                text: Translations.selection-hint;
                font-size: Theme.font-size-s;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
