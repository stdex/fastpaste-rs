// Main Window. The tree pane uses the reusable `TreeView` component from
// the `slint-tree-view` library crate (compiled as a Slint library module
// via the `experimental-module-builds` feature — the crate comes from
// crates.io: github.com/stdex/slint-tree-view). `TreeItem` is the
// matching struct, also from `@TreeView`.
//
// All TreeView state is mirrored here in MainWindow properties (single
// source of truth): the controller updates them in response to TreeView
// callbacks, and the values flow back into the TreeView via bindings.
//
// Keyboard: the Window `forward-focus`es the TreeView, so arrow-key
// navigation works as soon as the window opens (the TreeView declares
// its own `forward-focus` to an internal FocusScope; without this line
// key events never reach it).

import { TreeView, TreeItem } from "@TreeView";
import { TextEdit } from "std-widgets.slint";
import { Translations } from "translations.slint";
import { FButton, FLineEdit, Theme } from "widgets.slint";

export component MainWindow inherits Window {
    title: Translations.main-window-title;
    preferred-width: 800px;
    preferred-height: 500px;
    background: Theme.surface;

    // Tree model + current item (driven by the Rust controller).
    // `in-out` here so MainWindow remains the single source of truth for
    // the index — TreeView reads it via the binding below; we only ever
    // write to it from our `current-changed` callback (which fires on
    // TreeView's mouse/keyboard nav).
    in-out property <[TreeItem]> tree-model;
    in-out property <int> current-index: -1;

    // Editor pane state.
    //
    // Two enables, not one. `editor-enabled` means "this row has an
    // editable body" (false for folders); `title-enabled` means "this row
    // is a real, renameable item" (false for clipboard-history rows,
    // which are a read-only preview). Binding the title field to
    // `current-index >= 0` let the user type into a history row's title
    // and watch the text be silently discarded — the exact complaint the
    // body field was fixed for.
    in-out property <string> editor-title: "";
    in-out property <string> editor-body: "";
    in-out property <bool> editor-enabled: false;
    in-out property <bool> title-enabled: false;

    // Delete confirmation overlay. `delete-clicked` asks the controller
    // whether the selection needs confirming; if so it raises this and
    // waits for `delete-confirmed`.
    in-out property <bool> confirm-delete-visible: false;
    in-out property <string> confirm-delete-message: "";

    // ---- Toolbar callbacks ----
    callback add-folder-clicked();
    callback add-plain-clicked();
    callback delete-clicked();
    callback delete-confirmed();
    callback move-up-clicked();
    callback move-down-clicked();
    // ---- Editor callbacks ----
    callback title-edited(string);
    callback body-edited(string);
    // ---- Tree callbacks (forwarded from the embedded TreeView) ----
    /// The current item changed (click or keyboard). The id lets the
    /// controller correlate without tracking indices — but here we also
    /// need the index for the editor pane, so we read it back from
    /// `tree-model`.
    callback current-changed(int /* internal-id */);
    callback item-activated(int /* internal-id */);
    callback item-expand-requested(int /* internal-id */);
    callback item-collapse-requested(int /* internal-id */);
    /// Recursive expand/collapse (Asterisk key or Shift+double-click on
    /// a branch indicator). `depth == -1` means unlimited levels.
    callback recursive-expand-requested(
        int /* internal-id */, bool /* expand */, int /* depth */);
    /// Left-arrow on a collapsed branch or leaf: move current to parent.
    callback current-parent-change-requested(
        int /* internal-id */, int /* parent-internal-id */);

    // Arrow-key / Home / End / Enter navigation lands in the TreeView
    // from the moment the window is shown.
    forward-focus: tv;

    VerticalLayout {
        // Compact toolbar on a raised surface, separated by a hairline.
        Rectangle {
            height: Theme.control-height + 2 * 6px;
            vertical-stretch: 0;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: Theme.spacing;
                padding-right: Theme.spacing;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.spacing-s;
                alignment: start;

                FButton {
                    text: Translations.toolbar-add-folder;
                    clicked => { root.add-folder-clicked(); }
                }
                FButton {
                    text: Translations.toolbar-add-snippet;
                    clicked => { root.add-plain-clicked(); }
                }
                // Destructive action, kept off the shoulder of the two
                // additive ones.
                Rectangle {
                    width: Theme.spacing;
                    horizontal-stretch: 0;
                }
                FButton {
                    text: Translations.toolbar-delete;
                    danger: true;
                    clicked => { root.delete-clicked(); }
                }
                Rectangle {
                    width: 1px;
                    horizontal-stretch: 0;
                    background: Theme.border;
                }
                FButton {
                    text: "↑";
                    accessible-name: Translations.toolbar-move-up;
                    clicked => { root.move-up-clicked(); }
                }
                FButton {
                    text: "↓";
                    accessible-name: Translations.toolbar-move-down;
                    clicked => { root.move-down-clicked(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }

        // Two-pane: tree (left) + editor (right).
        HorizontalLayout {
            // Tree pane — the reusable TreeView from `slint-tree-view`.
            // The TreeView reports interactions back via its callbacks;
            // we mirror `current-index` here so MainWindow stays the
            // single source of truth.
            tv := TreeView {
                // The tree is the fixed pane; the editor takes the rest.
                preferred-width: 320px;
                min-width: 220px;
                horizontal-stretch: 0;
                model: root.tree-model;
                // TWO-WAY (`<=>`), never `:`. The TreeView assigns its own
                // `current-index` on a row click and in set-current /
                // move-current; a one-way binding is dropped by the first
                // such assignment, after which Rust-side
                // `set_current_index` updates MainWindow's copy while the
                // highlight stays where it was. Selection and highlight
                // then disagree — and Delete acts on the selection, so the
                // user can destroy a row other than the one they see
                // highlighted, recursively and without confirmation.
                current-index <=> root.current-index;
                // Main window is always "focused" — bind to real focus
                // tracking if you want greyed selection when not frontmost.
                focused: true;

                current-changed(id) => {
                    // No mirroring needed: `current-index` is aliased above.
                    root.current-changed(id);
                }
                item-activated(id) => {
                    root.item-activated(id);
                }
                item-expand-requested(id) => {
                    root.item-expand-requested(id);
                }
                item-collapse-requested(id) => {
                    root.item-collapse-requested(id);
                }
                recursive-expand-requested(id, expand, depth) => {
                    root.recursive-expand-requested(id, expand, depth);
                }
                current-parent-change-requested(id, parent-id) => {
                    root.current-parent-change-requested(id, parent-id);
                }
            }

            // Hairline between the panes. `horizontal-stretch: 0` is
            // load-bearing: a bare Rectangle stretches by default, so
            // this "1px" rule absorbed every spare pixel and rendered as
            // a ~245px grey column that squeezed the editor to a
            // letter-per-line sliver.
            Rectangle {
                width: 1px;
                horizontal-stretch: 0;
                background: Theme.border;
            }

            // Editor pane — takes whatever the tree does not.
            VerticalLayout {
                horizontal-stretch: 1;
                padding: Theme.padding;
                spacing: Theme.spacing-s;

                Text {
                    text: Translations.editor-title-label;
                    font-size: Theme.font-size-s;
                    color: Theme.text-muted;
                }
                FLineEdit {
                    text <=> root.editor-title;
                    enabled: root.title-enabled;
                    edited(t) => {
                        root.title-edited(t);
                    }
                }

                Text {
                    text: Translations.editor-body-label;
                    font-size: Theme.font-size-s;
                    color: Theme.text-muted;
                }
                // The one multiline editor: std TextEdit (fluent look is
                // close enough to the in-house set; Slint exposes no
                // multiline text primitive to build a custom one).
                TextEdit {
                    // TWO-WAY (`<=>`), never `:` — same hazard as
                    // `current-index` above, and here it corrupted data.
                    // TextEdit assigns its own `text` as the user types,
                    // which drops a one-way binding; from then on
                    // `set_editor_body` was inert, so selecting another
                    // item left the previous item's text in the pane and
                    // the next keystroke wrote it into the newly selected
                    // row.
                    text <=> root.editor-body;
                    enabled: root.editor-enabled;
                    edited(b) => {
                        root.body-edited(b);
                    }
                }
            }
        }
    }

    // ── Delete confirmation ──────────────────────────────────────────
    // Deleting a folder removes its whole subtree recursively and there
    // is no undo, so the destructive case asks first. Declared after the
    // main layout so it paints on top, and it takes focus while up so
    // Enter/Esc answer it rather than reaching the tree.
    if root.confirm-delete-visible: Rectangle {
        background: #00000066;

        // Swallow clicks on the backdrop so nothing behind reacts.
        TouchArea {}

        Rectangle {
            width: Math.min(root.width - 40px, 380px);
            height: card.preferred-height;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;

            card := VerticalLayout {
                padding: Theme.padding;
                spacing: Theme.spacing;

                Text {
                    text: Translations.confirm-delete-title;
                    font-size: Theme.font-size;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-delete-message;
                    font-size: Theme.font-size;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-s;
                    alignment: end;

                    FButton {
                        text: Translations.confirm-no;
                        clicked => { root.confirm-delete-visible = false; }
                    }
                    FButton {
                        text: Translations.confirm-yes;
                        primary: true;
                        danger: true;
                        clicked => {
                            root.confirm-delete-visible = false;
                            root.delete-confirmed();
                        }
                    }
                }
            }
        }

        confirm-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-delete-visible = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.confirm-delete-visible = false;
                    root.delete-confirmed();
                    return accept;
                }
                reject
            }
        }

        // Grab focus as the overlay appears. `init` is what does the
        // work — the element only exists while the `if` holds, so its
        // `visible` is the constant true and a `changed visible` handler
        // would never fire.
        init => { confirm-keys.focus(); }
    }
}
